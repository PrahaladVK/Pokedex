{
  "name": "pokedex",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "A Pokedex covering Gen 1-9 and Pokemon Legends Z-A, with versioned data packs and in-game version tracking.",
  "repository": {
    "type": "git",
    "url": "https://github.com/PrahaladVK/Pokedex.git"
  },
  "homepage": "https://github.com/PrahaladVK/Pokedex#readme",
  "bugs": {
    "url": "https://github.com/PrahaladVK/Pokedex/issues"
  },
  "scripts": {
    "typecheck": "pnpm -r --if-present run typecheck",
    "test": "pnpm -r --if-present run test",
    "lint": "pnpm -r --if-present run lint",
    "sync:pokeapi": "tsx scripts/sync-pokeapi.ts",
    "seed:legends-za": "tsx scripts/seed-legends-za.ts",
    "validate:data": "pnpm --filter @pokedex/core test",
    "mobile": "pnpm --filter @pokedex/mobile start"
  },
  "dependencies": {
    "@pokedex/schema": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  },
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20"
  }
}
